# Gemini API Key（到 https://aistudio.google.com/ 申請）
GEMINI_API_KEY=

# 筆記輸出資料夾（必填）
# 建議指到 Google Drive 的資料夾，筆記會自動同步到其他裝置
#   Windows 原生：OUTPUT_DIR=G:\我的雲端硬碟\Notes\YouTube_Notes
#   WSL：         OUTPUT_DIR=/mnt/g/我的雲端硬碟/Notes/YouTube_Notes（需先把 G: 掛載到 /mnt/g）
OUTPUT_DIR=

# （選填）指定模型，不設定時使用 gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash
